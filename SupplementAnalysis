# Index episode: medication prefix stack populated at the acute phase
get_index_episode <- function(data, suffix = "72") {
  ep_prefixes <- c(Mania = "MANIA", Depression = "DEP",
                   Mixed = "MIXED", `Schizoaffective-Mania` = "SCHAFMANIA")
  slots <- c("A", "B", "C", "D", "E")
  purrr::pmap_chr(data, function(...) {
    row <- list(...)
    counts <- sapply(ep_prefixes, function(pfx) {
      cols <- paste0(pfx, "_MEDICATION_CLASS_", slots, toupper(suffix))
      cols <- cols[cols %in% names(row)]
      sum(sapply(cols, function(c)
        !is.na(row[[c]]) && nchar(trimws(as.character(row[[c]]))) > 0))
    })
    if (max(counts) == 0) return(NA_character_)
    names(which.max(counts))
  })
}

