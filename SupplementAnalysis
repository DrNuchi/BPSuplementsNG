# ============================================================================ #
#  3.6  ESTIMATED BMR AND ILLNESS-HISTORY / TREATMENT-COMPLEXITY PROXIES      #
#       Correction method: BONFERRONI                                          #
# ============================================================================ #

proxy_vars <- c("total_episodes_3yr", "n_polarity_types",
                "n_ep_mania", "n_ep_mixed", "n_psych_acute")
proxy_labs <- c("Total episodes (3yr)", "Polarity types (n)",
                "Manic episodes (3yr)", "Mixed episodes (3yr)",
                "Psychotropic count (acute)")

run_cors <- function(dat, label) {
  out <- purrr::map2_dfr(proxy_vars, proxy_labs, function(v, lbl) {
    sub <- dat |> filter(!is.na(bmr), !is.na(.data[[v]]))
    ct  <- cor.test(sub$bmr, sub[[v]], method = "spearman", exact = FALSE)
    data.frame(Cohort = label, Proxy = lbl, n = nrow(sub),
               rho = round(ct$estimate, 3), p = round(ct$p.value, 4))
  })
  out$p.adj <- round(p.adjust(out$p, "bonferroni"), 4)
  out
}

cat("\n===== SPEARMAN CORRELATIONS (Bonferroni-corrected) =====\n")
print(run_cors(df_full,   "Full cohort"))
print(run_cors(df_supp,   "Supplement"))
print(run_cors(df_nosupp, "Non-supplement"))

mod_reg <- purrr::map_dfr(proxy_vars[1:4], function(sv) {
  sub <- df_full |> filter(!is.na(bmr), !is.na(.data[[sv]])) |>
    mutate(bmr_c = scale(bmr)[, 1])
  fit <- lm(as.formula(paste(sv,
    "~ bmr_c * any_supp + age + sex + psyc_comorbid + med_comorbid")),
    data = sub)
  cf <- coef(summary(fit))
  ir <- cf[grepl("bmr_c:any_supp", rownames(cf)), , drop = FALSE]
  if (nrow(ir) == 0) return(NULL)
  data.frame(Outcome = sv, Beta = round(ir[1, 1], 3), SE = round(ir[1, 2], 3),
             t = round(ir[1, 3], 3), p = round(ir[1, 4], 4),
             R2_adj = round(summary(fit)$adj.r.squared, 3))
})

cat("\n-- Moderated regression: supplement x BMR interaction --\n")
print(mod_reg)


