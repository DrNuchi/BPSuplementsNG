knn_imp <- function(target, features, k = 5) {
  obs <- which(!is.na(target)); mis <- which(is.na(target))
  if (!length(mis)) return(target)
  fm  <- as.matrix(features)
  mn  <- apply(fm[obs, , drop = FALSE], 2, min, na.rm = TRUE)
  rng <- pmax(apply(fm[obs, , drop = FALSE], 2, max, na.rm = TRUE) - mn, 1e-8)
  fn  <- sweep(sweep(fm, 2, mn, "-"), 2, rng, "/")
  for (j in seq_len(ncol(fn))) {
    nj <- is.na(fn[, j]); fn[nj, j] <- mean(fn[obs, j], na.rm = TRUE)
  }
  idx <- FNN::knnx.index(fn[obs, , drop = FALSE], fn[mis, , drop = FALSE], k = k)
  dst <- FNN::knnx.dist( fn[obs, , drop = FALSE], fn[mis, , drop = FALSE], k = k)
  target[mis] <- sapply(seq_len(nrow(idx)), function(i)
    weighted.mean(target[obs[idx[i, ]]], 1 / (dst[i, ] + 1e-10), na.rm = TRUE))
  target
}

