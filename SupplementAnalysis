df_full$supp_names_remission <- extract_supp_names("48")
df_full$supp_names_recovery  <- extract_supp_names("6MONTHS")

standardise_supp <- function(x) {
  x <- str_to_lower(str_trim(x))
  case_when(
    str_detect(x, "folic|folate")                                ~ "Folic acid",
    str_detect(x, "b.complex|b complex|meconerve|b12|cobalamin") ~ "B-complex/B12",
    str_detect(x, "thiamine|b1")                                 ~ "Thiamine (B1)",
    str_detect(x, "omega|fish oil")                              ~ "Omega-3 fatty acids",
    str_detect(x, "vitamin e|vit.e")                             ~ "Vitamin E",
    str_detect(x, "livolin")                                     ~ "Livolin",
    str_detect(x, "^supplements?$|^vitamins?$|^others?$|not recorded") ~ "Unspecified",
    nchar(x) == 0                                                ~ NA_character_,
    TRUE                                                         ~ str_to_title(x)
  )
}

