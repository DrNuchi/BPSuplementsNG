pairs_pers <- list(c("Single phase only", "Two phases"),
                   c("Single phase only", "All three phases"),
                   c("Two phases",        "All three phases"))

pairwise_es <- purrr::map_dfr(pairs_pers, function(pr) {
  g1 <- df_supp$bmr[df_supp$supp_persistence == pr[1] & !is.na(df_supp$bmr)]
  g2 <- df_supp$bmr[df_supp$supp_persistence == pr[2] & !is.na(df_supp$bmr)]
  wt <- wilcox.test(g1, g2, exact = FALSE)
  n1 <- length(g1); n2 <- length(g2)
  sp <- sqrt(((n1 - 1) * var(g1) + (n2 - 1) * var(g2)) / (n1 + n2 - 2))
  md <- mean(g1) - mean(g2)
  se <- sp * sqrt(1 / n1 + 1 / n2)
  data.frame(Comparison = paste(pr[1], "vs", pr[2]), n1 = n1, n2 = n2,
             mean_diff = round(md, 1),
             CI_low  = round(md - 1.96 * se, 1),
             CI_high = round(md + 1.96 * se, 1),
             cohens_d = round(md / sp, 3),
             rank_biserial = round(abs(1 - (2 * wt$statistic) / (n1 * n2)), 3),
             p.value = round(wt$p.value, 4))
})
pairwise_es$p.BH <- round(p.adjust(pairwise_es$p.value, "BH"), 4)
cat("\n-- Pairwise persistence comparisons (BH-corrected) --\n")
