# Supplement names from free-text fields, standardised to canonical categories
extract_supp_names <- function(suffix) {
  pcls <- cls_cols[str_ends(cls_cols, suffix)]
  pnms <- nm_cols[ str_ends(nm_cols,  suffix)]
  pair_list <- lapply(pcls, function(cc) {
    nc <- str_replace(cc, "_CLASS_", "_NAME_")
    if (nc %in% pnms) list(cls = cc, nm = nc) else NULL
  }) |> purrr::compact()
  sapply(seq_len(nrow(df_full)), function(i) {
    row  <- df_full[i, ]
    hits <- vapply(pair_list, function(p) {
      if (is_supp_class(row[[p$cls]])) {
        nv <- trimws(as.character(row[[p$nm]]))
        if (!is.na(nv) && nchar(nv) > 0 && nv != "NA") nv else "Not recorded"
      } else NA_character_
    }, character(1))
    hits <- hits[!is.na(hits)]
    if (length(hits) == 0) "" else paste(unique(hits), collapse = "; ")
  })
}

