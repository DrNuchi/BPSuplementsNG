cochran_q <- function(mat) {
  mat <- as.matrix(mat); k <- ncol(mat)
  L <- rowSums(mat); C <- colSums(mat)
  Q <- ((k - 1) * (k * sum(C^2) - sum(C)^2)) / (k * sum(L) - sum(L^2))
  list(Q = Q, df = k - 1, p = pchisq(Q, df = k - 1, lower.tail = FALSE))
}

