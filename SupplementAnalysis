is_ap <- function(x) str_detect(as.character(x), regex("antipsychotic",  ignore_case = TRUE)) & !is.na(x)
is_ms <- function(x) str_detect(as.character(x), regex("mood.stabil",    ignore_case = TRUE)) & !is.na(x)
is_ad <- function(x) str_detect(as.character(x), regex("antidepressant", ignore_case = TRUE)) & !is.na(x)

build_phase_vars <- function(data, suffix, label) {
  pcls <- cls_cols[str_ends(cls_cols, suffix)]
  cm   <- as.data.frame(data[, pcls])
  data[[paste0("ap_", label)]] <-
    apply(cm, 1, function(r) as.integer(any(is_ap(r[!is.na(r)]))))
  data[[paste0("ms_", label)]] <-
    apply(cm, 1, function(r) as.integer(any(is_ms(r[!is.na(r)]))))
  data[[paste0("ad_", label)]] <-
    apply(cm, 1, function(r) as.integer(any(is_ad(r[!is.na(r)]))))
  data[[paste0("n_psych_", label)]] <-
    apply(cm, 1, function(r) sum(!is.na(r) & nchar(trimws(as.character(r))) > 0))
  data[[paste0("poly_", label)]] <-
    as.integer(data[[paste0("n_psych_", label)]] >= 3)
  data
}

